/-  *chorus
|_  val=(map ship listing:bio)
++  grad  %noun
++  grow
  |%
  ++  noun  val
  ::  the wick is for verification, not for clients: json gives
  ::  the plaintext bio alone
  ++  json
    ^-  ^json
    :-  %o
    %-  ~(gas by *(map @t ^json))
    %+  turn  ~(tap by val)
    |=  [=ship lit=listing:bio]
    [(scot %p ship) s+txt.lit]
  --
++  grab
  |%
  ++  noun  ,(map ship listing:bio)
  --
--
