/-  *chorus
|_  val=(map ship (set (pair desk desc)))
++  grad  %noun
++  grow
  |%
  ++  noun  val
  ++  json
    ^-  ^json
    :-  %o
    %-  ~(gas by *(map @t ^json))
    %+  turn  ~(tap by val)
    |=  [=ship apps=(set (pair desk desc))]
    :-  (scot %p ship)
    :-  %a
    %+  turn  ~(tap in apps)
    |=  [p=desk q=desc]
    %-  pairs:enjs:format
    :~  ['desk' s+p]
        ['desc' s+q]
    ==
  --
++  grab
  |%
  ++  noun  ,(map ship (set (pair desk desc)))
  --
--
