/-  *chorus
|_  val=(map ship (set [=desk =desc]))
++  grad  %noun
++  grow
  |%
  ++  noun  val
  ++  json
    ^-  ^json
    :-  %o
    %-  ~(gas by *(map @t ^json))
    %+  turn  ~(tap by val)
    |=  [=ship desks=(set [=desk =desc])]
    :-  (scot %p ship)
    :-  %a
    %+  turn  ~(tap in desks)
    |=  [=desk =desc]
    %-  pairs:enjs:format
    :~  ['desk' s+desk]
        ['desc' s+desc]
    ==
  --
++  grab
  |%
  ++  noun  ,(map ship (set [=desk =desc]))
  --
--
