/-  *chorus
|_  val=(set listing:desk)
++  grad  %noun
++  grow
  |%
  ++  noun  val
  ++  json
    ^-  ^json
    :-  %a
    %+  turn  ~(tap in val)
    |=  lit=listing:desk
    %-  pairs:enjs:format
    :~  ['ship' s+(scot %p ship.lit)]
        ['desk' s+desk.lit]
        ['desc' s+desc.lit]
        ['hash' s+(scot %uv hash.lit)]
    ==
  --
++  grab
  |%
  ++  noun  ,(set listing:desk)
  --
--
