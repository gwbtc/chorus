/-  *chorus
|_  val=(map ship (set announcement))
++  grad  %noun
++  grow
  |%
  ++  noun  val
  ++  json
    ^-  ^json
    :-  %o
    %-  ~(gas by *(map @t ^json))
    %+  turn  ~(tap by val)
    |=  [=ship announcements=(set announcement)]
    :-  (scot %p ship)
    :-  %a
    %+  turn  ~(tap in announcements)
    |=  =announcement
    s+announcement
  --
++  grab
  |%
  ++  noun  ,(map ship (set announcement))
  --
--
