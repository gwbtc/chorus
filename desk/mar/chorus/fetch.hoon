/-  *chorus
|_  act=fetch
++  grad  %noun
++  grow
  |%
  ++  noun  act
  --
++  grab
  |%
  ++  noun  ,fetch
  ::
  ::  a ship as a @p. a nym will not do: only a comet's nym
  ::  names its address, and any other ship's decodes to a
  ::  comet that does not exist
  ::  {"drawer": "/projects", "ships": ["~sampel-palnet"]}
  ++  json
    |=  jon=^json
    ^-  fetch
    =,  dejs:format
    %.  jon
    (ot ~[drawer+pa ships+(as (se %p))])
  --
--
